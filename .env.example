# =============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.
# =============================================================================

# --- Base de datos (PostgreSQL) ---
# Ejemplo local: postgresql://excoba_user:excoba_pass@localhost:5432/excoba_dev
DATABASE_URL="postgresql://user:password@localhost:5432/excoba_dev"

# --- Aplicación ---
# URL pública de la plataforma (usada para links en correos, cookies, etc.)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sesiones y cookies ---
# Cadena aleatoria larga (mínimo 32 caracteres) usada para firmar cookies de sesión.
# Generar con: openssl rand -base64 48
SESSION_SECRET="reemplaza-esto-con-una-cadena-aleatoria-larga"

# --- Correo transaccional ---
# Proveedor configurable (ej. Resend, Postmark, SMTP genérico). Ajustar según
# el proveedor elegido en el Módulo 4/5 (recuperación de contraseña, licencias).
EMAIL_PROVIDER="smtp"
EMAIL_FROM="no-responder@tudominio.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Rate limiting ---
# Backend de rate limiting. En el MVP puede ser "memory" (un solo proceso);
# en producción con más de una instancia se recomienda "redis".
RATE_LIMIT_BACKEND="memory"
REDIS_URL=""
